DB_USER=wgwarden
DB_PASSWORD=
# openssl rand -base64 32
APP_MASTER_KEY=
# openssl rand -base64 48
JWT_SECRET=
# Одноразовый токен для создания первого аккаунта (генерируется install.sh).
APP_BOOTSTRAP_TOKEN=
# false — регистрация закрыта; true — открыта всем (не рекомендуется).
APP_REGISTRATION_ENABLED=false
# Сколько Argon2-хешей считать одновременно (ограничение памяти).
APP_PASSWORD_HASH_CONCURRENCY=2
MONITORING_INTERVAL=60s
WEB_PORT=8080
PGDATA_VOLUME=wg-warden_pgdata
