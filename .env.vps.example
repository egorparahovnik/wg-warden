# Настройки для запуска на VPS: ./deploy/vps-install.sh
# Не используйте этот файл для локального запуска (там нужен .env).

# Порт панели. 80 — открывается по адресу http://<IP-VPS>; 8080 — если 80 занят.
WEB_PORT=80

DB_USER=wgwarden
DB_PASSWORD=
# openssl rand -base64 32
APP_MASTER_KEY=
# openssl rand -base64 48
JWT_SECRET=

# false — после того как создали свой аккаунт: регистрация новых пользователей закрывается.
APP_REGISTRATION_ENABLED=true

MONITORING_INTERVAL=60s
PGDATA_VOLUME=wg-warden_vps_pgdata
